# Base Postgres
DATABASE_URL=postgres://jemima:jemima@127.0.0.1:5435/jemima
# Secret Payload (32+ caractères aléatoires : openssl rand -hex 32)
PAYLOAD_SECRET=
# URL publique du site (sans / final) et environnement : development | staging | production
SITE_URL=http://localhost:3000
SITE_ENV=development
# MinIO / S3 (endpoint interne pour l'upload, URL publique pour les navigateurs)
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MEDIA_PUBLIC_URL=http://127.0.0.1:9100/media
# Premier compte admin, créé au démarrage si la base n'a aucun utilisateur
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SMTP (facultatif en local : sans SMTP_HOST, les e-mails sont affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@koklo.dev
